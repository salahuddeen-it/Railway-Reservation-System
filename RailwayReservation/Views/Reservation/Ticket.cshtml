@model RailwayReservation.ViewModels.ReservationDetailsViewModel
@{
    ViewBag.Title = "Ticket " + Model.Reservation.Pnr;
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4 class="mb-0"><i class="bi bi-ticket-detailed"></i> E-Ticket</h4>
    <div>
        <button type="button" onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Print</button>
        <a href="@Url.Action("Create")" class="btn btn-outline-secondary">New Booking</a>
    </div>
</div>
@Html.Partial("_ReservationDetails", Model)