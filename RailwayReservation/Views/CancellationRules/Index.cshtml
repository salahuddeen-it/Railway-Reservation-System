@using RailwayReservation.Helpers
@model IEnumerable<RailwayReservation.Models.CancellationRule>
@{
    ViewBag.Title = "Cancellation Rules";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-x-octagon"></i> Cancellation Fee Rules</h4>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Rule</a>
</div>
<p class="text-muted small">The rule with the highest "hours" that is still ≤ hours left before departure is applied. Fee = max(fare × %, minimum charge).</p>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Class</th><th>If cancelled ≥ hours before</th><th>Deduction %</th><th>Minimum Charge (Rs.)</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.TravelClass.GetDisplayName()</td>
                        <td>@c.MinHoursBeforeDeparture hrs</td>
                        <td>@c.DeductionPercent.ToString("0.##")%</td>
                        <td>@c.MinimumCharge.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a href="@Url.Action("Edit", new { id = c.CancellationRuleId })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            @using (Html.BeginForm("Delete", "CancellationRules", new { id = c.CancellationRuleId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete this rule?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>