@model IEnumerable<RailwayReservation.Models.Passenger>
@{
    ViewBag.Title = "Waitlist Allocation";
    DateTime d = ViewBag.Date;
}
<h4 class="mb-3"><i class="bi bi-hourglass-split"></i> Update Seats for Waitlisted Passengers</h4>
<p class="text-muted small">Scheduled activity: allocates vacant seats (from cancellations) to waitlisted passengers of the selected journey date, lowest WL number first.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="date" name="date" value="@d.ToString("yyyy-MM-dd")" class="form-control" />
        <button type="submit" class="btn btn-outline-secondary">Show</button>
    </form>
    @using (Html.BeginForm("Allocate", "Waitlist", FormMethod.Post, new { onsubmit = "return confirm('Allocate vacant seats now?');" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="date" value="@d.ToString("yyyy-MM-dd")" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat"></i> Allocate Seats</button>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">Waitlisted passengers – @d.ToString("dd MMM yyyy (ddd)")</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Train</th><th>Class</th><th>PNR</th><th>Passenger</th><th>Age</th><th>WL No</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Reservation.Train.TrainNo – @p.Reservation.Train.TrainName</td>
                        <td>@p.Reservation.TravelClass</td>
                        <td><a href="@Url.Action("Index", "Query", new { pnr = p.Reservation.Pnr })">@p.Reservation.Pnr</a></td>
                        <td>@p.Name</td>
                        <td>@p.Age</td>
                        <td><span class="badge bg-warning text-dark">WL @p.WaitlistNo</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No waitlisted passengers for this date.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>