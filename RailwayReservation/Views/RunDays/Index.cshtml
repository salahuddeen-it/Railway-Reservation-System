@model IEnumerable<RailwayReservation.Models.Train>
@{
    ViewBag.Title = "Day Master";
}
<h4 class="mb-3"><i class="bi bi-calendar-week"></i> Day Master – Train Running Days</h4>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Train No</th><th>Train Name</th><th>Runs On</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.TrainNo</td>
                        <td>@t.TrainName</td>
                        <td>@(t.RunDay != null ? t.RunDay.DaysText : "Not set")</td>
                        <td class="text-end">
                            <a href="@Url.Action("Edit", new { id = t.TrainNo })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit Days</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>