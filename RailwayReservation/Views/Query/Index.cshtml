@model RailwayReservation.ViewModels.ReservationDetailsViewModel
@{
    ViewBag.Title = "PNR Query";
}
<h4 class="mb-3"><i class="bi bi-search"></i> PNR Enquiry</h4>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-4">
        <input type="text" name="pnr" value="@ViewBag.Pnr" class="form-control" placeholder="Enter 10-digit PNR" maxlength="10" required />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Get Status</button></div>
</form>

@if (ViewBag.NotFound != null)
{
    <div class="alert alert-warning">PNR not found. Please check the number.</div>
}

@if (Model != null)
{
    <div class="d-flex justify-content-end mb-2 no-print">
        <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer"></i> Print</button>
    </div>
    @Html.Partial("_ReservationDetails", Model)
}