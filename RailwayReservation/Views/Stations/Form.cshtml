@model RailwayReservation.Models.Station
@{
    bool isEdit = Model.StationId > 0;
    ViewBag.Title = isEdit ? "Edit Station" : "Add Station";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h5 class="mb-0">@ViewBag.Title</h5></div>
            <div class="card-body">
                @using (Html.BeginForm(isEdit ? "Edit" : "Create", "Stations", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    @Html.HiddenFor(m => m.StationId)

                    <div class="mb-3">
                        @Html.LabelFor(m => m.StationCode, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.StationCode, new { @class = "form-control", maxlength = "10", oninput = "this.value=this.value.toUpperCase()" })
                        @Html.ValidationMessageFor(m => m.StationCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.StationName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.StationName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StationName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.DivisionName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.DivisionName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.DivisionName, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>
        </div>
    </div>
</div>